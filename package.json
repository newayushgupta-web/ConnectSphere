{
  "name": "connectsphere",
  "version": "1.0.0",
  "description": "ConnectSphere - Mini Social Media Platform (CodeAlpha Internship Task 2)",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test",
    "build": "cd client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["social-media", "full-stack", "mern", "react", "express", "socket.io"],
  "author": "CodeAlpha Intern",
  "license": "MIT"
}
