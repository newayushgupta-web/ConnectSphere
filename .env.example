# ConnectSphere Environment Variables Configuration

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (defaults to automated in-memory MongoDB if omitted in dev)
# For local MongoDB: mongodb://localhost:27017/connectsphere
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/connectsphere?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret & Expiration
JWT_SECRET=connectsphere_super_secret_jwt_key_2026_codealpha
JWT_EXPIRE=7d

# Client URL (for CORS and Socket.io whitelist)
CLIENT_URL=http://localhost:3000

# Upload Directory (relative or absolute)
UPLOAD_PATH=uploads

# Optional Cloudinary Configuration (for cloud-based uploads in production)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
